NETWORK_NAME=o1labs-fetcher

POSTGRES_VERSION=15-alpine
POSTGRES_USER=postgres
POSTGRES_PASSWORD=xxxxxx
POSTGRES_DB=logs

UPTIME_BACKEND_API_URL=http://localhost:3000

# Users allowed to POST to the orchestrator service (run, test, cancel): an
# htpasswd file inside the container; ./keys is mounted at /keys, so for
# example `htpasswd -Bc keys/write-auth.htpasswd n8n`. Set
# ALLOW_UNAUTHENTICATED_WRITES=1 instead only on a private network.
WRITE_AUTH_USERS_FILE=/keys/write-auth.htpasswd
ALLOW_UNAUTHENTICATED_WRITES=
HOST_OVERRIDES="--host-overrides 'host-{}-example.com'"
